{
  "manifest_version": 3,
  "name": "LinkedIn AI Assistant",
  "version": "2.0",
  "description": "Assistant IA pour LinkedIn propulsé par Gemini",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://*.licdn.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "prompts.js",
        "content.js",
        "api_key.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}